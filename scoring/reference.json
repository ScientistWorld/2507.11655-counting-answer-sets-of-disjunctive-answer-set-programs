        "sharpasp_sr": {"type": "proposed", "solved_instances": 825, "par2": 2939}
      }
    },
    "paper_hybrid_benchmark": {
      "description": "Paper hybrid benchmark using clingo enumeration up to 10000 answer sets followed by a counter fallback.",
      "weight": 0.2,
      "primary_metric": "solved_instances",
      "metrics": {
        "solved_instances": {"higher_is_better": true, "coefficient": 1.0},
        "par2": {"higher_is_better": false, "coefficient": -0.5}
      },
      "results": {
        "clingo": {"type": "baseline", "solved_instances": 708, "par2": 4118},
