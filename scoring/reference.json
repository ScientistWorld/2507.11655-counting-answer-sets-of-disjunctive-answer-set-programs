{
  "experiments": {
    "paper_main_benchmark": {
      "description": "Paper headline benchmark on 1125 non-tight disjunctive ASP instances, 5000s timeout and 8 GB memory.",
      "weight": 0.45,
      "primary_metric": "solved_instances",
      "metrics": {
        "solved_instances": {"higher_is_better": true, "coefficient": 1.0},
        "par2": {"higher_is_better": false, "coefficient": -0.5}
